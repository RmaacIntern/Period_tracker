<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme -->
    <style name="Base.Theme.PeriodTracker" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- ← Fix translucent flags HERE, not in CycleChip -->
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>

        <!-- Dark mode: window + system bars follow the day/night tokens -->
        <item name="android:windowBackground">@color/surface_bg</item>
        <item name="android:statusBarColor">@color/app_bg</item>
        <item name="android:navigationBarColor">@color/surface_card</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/light_system_bars</item>
    </style>

    <style name="Theme.PeriodTracker" parent="Base.Theme.PeriodTracker" />

    <style name="WeekdayLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="ConditionChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="chipBackgroundColor">@color/chip_background_selector</item>
        <item name="chipStrokeColor">@color/chip_stroke_selector</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <style name="CycleChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/chip_text_selector</item>
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="chipStrokeWidth">2dp</item>
        <item name="chipStrokeColor">@color/chip_stroke_selector</item>
        <item name="chipCornerRadius">100dp</item>
        <item name="chipMinHeight">34dp</item>
        <item name="chipStartPadding">12dp</item>
        <item name="chipEndPadding">12dp</item>
        <item name="android:checkable">true</item>
        <item name="checkedIconVisible">false</item>
        <item name="rippleColor">#20EC4899</item>
        <!-- ← Window flags removed from here, they don't belong in a Chip style -->
    </style>

</resources>