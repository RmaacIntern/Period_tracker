<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/bottom_sheet_bg"
    android:paddingHorizontal="@dimen/_20sdp"
    android:paddingTop="@dimen/_10sdp"
    android:paddingBottom="@dimen/_27sdp">

    <!-- Handle -->
    <View
        android:layout_width="@dimen/_34sdp"
        android:layout_height="@dimen/_3sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/_7sdp"
        android:layout_marginBottom="@dimen/_17sdp"
        android:background="@drawable/sheet_handle" />

    <!-- PDF Icon circle -->
    <FrameLayout
        android:layout_width="@dimen/_50sdp"
        android:layout_height="@dimen/_50sdp"
        android:layout_marginBottom="@dimen/_14sdp"
        android:background="@drawable/bg_period_confirm_outer">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="PDF"
            android:textStyle="bold"
            android:textColor="#E63A5E"
            android:textSize="@dimen/_12ssp" />

    </FrameLayout>

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PDF Report Ready"
        android:textSize="@dimen/_15ssp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="@dimen/_5sdp" />

    <!-- Message -->
    <TextView
        android:id="@+id/tvPdfPath"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Saved to Downloads/PeriodTracker_Report.pdf"
        android:textSize="@dimen/_11ssp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:layout_marginBottom="@dimen/_20sdp" />

    <!-- Open PDF button -->
    <Button
        android:id="@+id/btnOpenPdf"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_44sdp"
        android:text="Open PDF"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/_13ssp"
        android:backgroundTint="#EC4899"
        app:cornerRadius="@dimen/_12sdp"
        android:layout_marginBottom="@dimen/_10sdp" />

    <!-- Close button -->
    <TextView
        android:id="@+id/btnClosePdf"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_34sdp"
        android:gravity="center"
        android:text="Close"
        android:textSize="@dimen/_12ssp"
        android:textColor="@color/text_secondary" />

</LinearLayout>