<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="10dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/entryCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- Time bold left -->
        <TextView
            android:id="@+id/tvEntryTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="9:05 PM"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#2D1B33"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Log type label right (Morning Log / Evening Log / Midday Log) -->
        <TextView
            android:id="@+id/tvEntryType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Evening Log"
            android:textSize="11sp"
            android:textColor="#8A7A8F"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBaseline_toBaselineOf="@id/tvEntryTime" />

        <!-- Chip row: flow + moods + symptoms -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupEntry"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:chipSpacingHorizontal="6dp"
            app:chipSpacingVertical="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvEntryTime" />

        <!-- BBT row (only visible if basalTemp logged) -->
        <LinearLayout
            android:id="@+id/bbtRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/chipGroupEntry">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌡"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvBbtEntry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="97.8°F"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#2D1B33" />

        </LinearLayout>

        <!-- Notes italic grey -->
        <TextView
            android:id="@+id/tvNotesEntry"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textSize="12sp"
            android:textColor="#8A7A8F"
            android:textStyle="italic"
            android:lineSpacingExtra="2dp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/bbtRow" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>