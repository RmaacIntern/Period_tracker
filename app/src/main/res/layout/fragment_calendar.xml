<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/surface_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/_20sdp">

        <!-- TOP BAR -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_48sdp"
            android:paddingHorizontal="@dimen/_17sdp"
            android:background="@color/surface_bg">
            <TextView
                android:id="@+id/tvCalendarTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Calendar"
                android:textSize="@dimen/_18ssp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- MONTH + NAV ROW -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/_17sdp"
            android:paddingTop="@dimen/_3sdp"
            android:paddingBottom="@dimen/_8sdp">

            <TextView
                android:id="@+id/tvMonthYear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="October 2024"
                android:textSize="@dimen/_16ssp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <View
                android:id="@+id/tvMonthDot"
                android:layout_width="@dimen/_7sdp"
                android:layout_height="@dimen/_7sdp"
                android:layout_marginStart="@dimen/_5sdp"
                app:layout_constraintStart_toEndOf="@id/tvMonthYear"
                app:layout_constraintTop_toTopOf="@id/tvMonthYear"
                app:layout_constraintBottom_toBottomOf="@id/tvMonthYear" />

            <LinearLayout
                android:id="@+id/navRow"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_30sdp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageView
                    android:id="@+id/btnPrevMonth"
                    android:layout_width="@dimen/_30sdp"
                    android:layout_height="@dimen/_30sdp"
                    android:padding="@dimen/_2sdp"
                    android:src="@drawable/ic_back"
                    android:background="@drawable/bg_arrow_shadow"
                    android:scaleType="centerInside"
                    android:contentDescription="Previous month" />

                <View
                    android:layout_width="@dimen/_3sdp"
                    android:layout_height="match_parent" />

                <ImageView
                    android:id="@+id/btnNextMonth"
                    android:layout_width="@dimen/_30sdp"
                    android:layout_height="@dimen/_30sdp"
                    android:padding="@dimen/_2sdp"
                    android:src="@drawable/ic_next"
                    android:background="@drawable/bg_arrow_shadow"
                    android:scaleType="centerInside"
                    android:contentDescription="Next month" />

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- VIEW MODE TABS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_17sdp"
            android:paddingBottom="@dimen/_10sdp">
            <TextView
                android:id="@+id/tabMonth"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_32sdp"
                android:gravity="center"
                android:text="Month"
                android:textSize="@dimen/_11ssp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:paddingHorizontal="@dimen/_18sdp" />
        </LinearLayout>

        <!-- CALENDAR CARD -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/calendarCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_14sdp"
            android:layout_marginEnd="@dimen/_14sdp"
            android:paddingHorizontal="@dimen/_7sdp"
            android:paddingTop="@dimen/_10sdp"
            android:paddingBottom="@dimen/_12sdp">

            <com.aivigil.periodtracker.calendar.CycleCalendarView
                android:id="@+id/cycleCalendarView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/cycleProgressBar"
                android:layout_width="0dp"
                android:layout_height="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:orientation="horizontal"
                android:baselineAligned="false"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cycleCalendarView">
                <View android:id="@+id/barPeriod"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="5" android:background="#C2185B" />
                <View android:id="@+id/barFertile"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="9" android:background="@color/cycle_fertile" />
                <View android:id="@+id/barRemaining"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="14" android:background="#6D6D6D" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCycleDay1Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:text="Cycle Day 1"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_8ssp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cycleProgressBar" />

            <TextView
                android:id="@+id/tvEstDaysLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Est. 28 Days"
                android:textSize="@dimen/_8ssp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="@dimen/_3sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cycleProgressBar" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- LEGEND -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_17sdp"
            android:layout_marginEnd="@dimen/_17sdp"
            android:layout_marginTop="@dimen/_14sdp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/_7sdp">
                    <View android:id="@+id/legendPeriodDot"
                        android:layout_width="@dimen/_8sdp" android:layout_height="@dimen/_8sdp"
                        android:background="#C2185B" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Period" android:textSize="@dimen/_10ssp"
                        android:textColor="@color/text_primary"
                        android:layout_marginStart="@dimen/_7sdp" />
                </LinearLayout>

                <LinearLayout android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <View android:id="@+id/legendOvulationDot"
                        android:layout_width="@dimen/_8sdp" android:layout_height="@dimen/_8sdp"
                        android:background="@color/brand_purple_deep" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Ovulation" android:textSize="@dimen/_10ssp"
                        android:textColor="@color/text_primary"
                        android:layout_marginStart="@dimen/_7sdp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/_7sdp">
                    <View android:id="@+id/legendFertileDot"
                        android:layout_width="@dimen/_8sdp" android:layout_height="@dimen/_8sdp"
                        android:background="@color/cycle_fertile" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Fertile window" android:textSize="@dimen/_10ssp"
                        android:textColor="@color/text_primary"
                        android:layout_marginStart="@dimen/_7sdp" />
                </LinearLayout>

                <LinearLayout android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <View android:id="@+id/legendPredictedDot"
                        android:layout_width="@dimen/_8sdp" android:layout_height="@dimen/_8sdp"
                        android:background="@color/cycle_predicted" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Predicted Period" android:textSize="@dimen/_10ssp"
                        android:textColor="@color/text_primary"
                        android:layout_marginStart="@dimen/_7sdp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- SELECTED DAY DETAIL CARD -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/selectedDayCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_14sdp"
            android:layout_marginEnd="@dimen/_14sdp"
            android:layout_marginTop="@dimen/_14sdp"
            android:padding="@dimen/_14sdp">

            <TextView
                android:id="@+id/tvSelectedDayFull"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Monday, October 14"
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvPhaseBadge" />

            <TextView
                android:id="@+id/tvPhaseBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☀ Fertile Window"
                android:textSize="@dimen/_9ssp"
                android:textStyle="bold"
                android:textColor="@color/cycle_fertile"
                android:paddingHorizontal="@dimen/_8sdp"
                android:paddingVertical="@dimen/_4sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvSelectedDaySub"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:text="Cycle Day 12 · 14 Days until next period"
                android:textSize="@dimen/_10ssp"
                android:textColor="@color/text_secondary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSelectedDayFull" />

            <!-- Energy / Libido / Sleep row -->
            <LinearLayout
                android:id="@+id/dayStatRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSelectedDaySub">

                <LinearLayout android:id="@+id/cardEnergy"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="@dimen/_5sdp"
                    android:orientation="vertical" android:gravity="center"
                    android:padding="@dimen/_10sdp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="⚡" android:textSize="@dimen/_15ssp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp" android:text="ENERGY"
                        android:textSize="@dimen/_7ssp" android:textStyle="bold"
                        android:letterSpacing="0.05" android:textColor="@color/text_secondary" />
                    <TextView android:id="@+id/tvEnergyValue"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sdp" android:text="High"
                        android:textSize="@dimen/_11ssp" android:textStyle="bold"
                        android:textColor="@color/text_primary" />
                    <TextView android:id="@+id/tvEnergySource"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sdp" android:text="estimated"
                        android:textSize="@dimen/_7ssp" android:textColor="#A855F7" />
                </LinearLayout>

                <LinearLayout android:id="@+id/cardLibido"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="@dimen/_5sdp"
                    android:orientation="vertical" android:gravity="center"
                    android:padding="@dimen/_10sdp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🤍" android:textSize="@dimen/_15ssp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp" android:text="LIBIDO"
                        android:textSize="@dimen/_7ssp" android:textStyle="bold"
                        android:letterSpacing="0.05" android:textColor="@color/text_secondary" />
                    <TextView android:id="@+id/tvLibidoValue"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sdp" android:text="Normal"
                        android:textSize="@dimen/_11ssp" android:textStyle="bold"
                        android:textColor="@color/text_primary" />
                    <TextView android:id="@+id/tvLibidoSource"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sdp" android:text="estimated"
                        android:textSize="@dimen/_7ssp" android:textColor="#A855F7" />
                </LinearLayout>

                <LinearLayout android:id="@+id/cardSleep"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical" android:gravity="center"
                    android:padding="@dimen/_10sdp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🌙" android:textSize="@dimen/_15ssp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp" android:text="SLEEP"
                        android:textSize="@dimen/_7ssp" android:textStyle="bold"
                        android:letterSpacing="0.05" android:textColor="@color/text_secondary" />
                    <TextView android:id="@+id/tvSleepValue"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sdp" android:text="7.5 hrs"
                        android:textSize="@dimen/_11ssp" android:textStyle="bold"
                        android:textColor="@color/text_primary" />
                    <TextView android:id="@+id/tvSleepSource"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sdp" android:text="estimated"
                        android:textSize="@dimen/_7ssp" android:textColor="#A855F7" />
                </LinearLayout>
            </LinearLayout>

            <!-- Cervical fluid row -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cervicalRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:padding="@dimen/_10sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/dayStatRow">

                <TextView android:id="@+id/iconCervical"
                    android:layout_width="@dimen/_27sdp"
                    android:layout_height="@dimen/_27sdp"
                    android:gravity="center" android:text="💧"
                    android:textSize="@dimen/_12ssp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/_8sdp"
                    app:layout_constraintStart_toEndOf="@id/iconCervical"
                    app:layout_constraintEnd_toStartOf="@id/tvFertilityChance"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Cervical Fluid"
                        android:textSize="@dimen/_8ssp"
                        android:textColor="@color/text_secondary" />
                    <TextView android:id="@+id/tvCervicalValue"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Creamy · Low viscosity"
                        android:textSize="@dimen/_11ssp"
                        android:textStyle="bold" android:textColor="@color/text_primary" />
                </LinearLayout>

                <TextView android:id="@+id/tvFertilityChance"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Chances: High"
                    android:textSize="@dimen/_9ssp"
                    android:textStyle="bold" android:textColor="#EC4899"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Period Start Section -->
            <LinearLayout
                android:id="@+id/periodStartSection"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:orientation="vertical"
                android:padding="@dimen/_10sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cervicalRow">

                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/_8sdp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="🩸  Period Start"
                        android:textSize="@dimen/_11ssp" android:textStyle="bold"
                        android:textColor="@color/text_primary" />
                    <TextView android:id="@+id/tvPeriodStartStatus"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Not set"
                        android:textSize="@dimen/_9ssp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <com.aivigil.periodtracker.widgets.GradientButton
                    android:id="@+id/btnLogPeriodStart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:text="🩸  Log Period Start" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- DAILY TIP CARD -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/dailyTipCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_14sdp"
            android:layout_marginEnd="@dimen/_14sdp"
            android:layout_marginTop="@dimen/_12sdp"
            android:padding="@dimen/_12sdp">

            <TextView android:id="@+id/ivTipImage"
                android:layout_width="@dimen/_54sdp"
                android:layout_height="@dimen/_54sdp"
                android:gravity="center" android:text="🌸"
                android:textSize="@dimen/_22ssp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/_10sdp"
                app:layout_constraintStart_toEndOf="@id/ivTipImage"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="DAILY TIP"
                    android:textSize="@dimen/_7ssp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" android:textColor="#EC4899" />
                <TextView android:id="@+id/tvTipTitle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp" android:text=""
                    android:textSize="@dimen/_12ssp" android:textStyle="bold"
                    android:textColor="@color/text_primary" />
                <TextView android:id="@+id/tvTipBody"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_3sdp" android:text=""
                    android:textSize="@dimen/_9ssp"
                    android:textColor="@color/text_secondary"
                    android:maxLines="2" android:ellipsize="end" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>