<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FBF5F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- TOP BAR -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="20dp"
            android:background="#FBF5F8">

            <TextView
                android:id="@+id/tvCalendarTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Calendar"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#2D1B33"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>



        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- MONTH + NAV ROW -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tvMonthYear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="October 2024"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#2D1B33"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <View
                android:id="@+id/tvMonthDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="6dp"
                app:layout_constraintStart_toEndOf="@id/tvMonthYear"
                app:layout_constraintTop_toTopOf="@id/tvMonthYear"
                app:layout_constraintBottom_toBottomOf="@id/tvMonthYear" />

            <LinearLayout
                android:id="@+id/navRow"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:id="@+id/btnPrevMonth"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="‹"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#2D1B33" />

                <TextView
                    android:id="@+id/btnNextMonth"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="›"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#2D1B33" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- VIEW MODE TABS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tabMonth"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:gravity="center"
                android:text="Month"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:paddingHorizontal="22dp" />



        </LinearLayout>

        <!-- CALENDAR CARD -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/calendarCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:paddingHorizontal="8dp"
            android:paddingTop="12dp"
            android:paddingBottom="14dp">

            <com.aivigil.periodtracker.calendar.CycleCalendarView
                android:id="@+id/cycleCalendarView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 3-segment progress bar with updated colors -->
            <LinearLayout
                android:id="@+id/cycleProgressBar"
                android:layout_width="0dp"
                android:layout_height="5dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:baselineAligned="false"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cycleCalendarView">

                <View
                    android:id="@+id/barPeriod"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="5"
                    android:background="#C2185B" /> <!-- Period Pink -->

                <View
                    android:id="@+id/barFertile"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="9"
                    android:background="#3B7A57" /> <!-- Fertile Sage Green -->

                <View
                    android:id="@+id/barRemaining"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="14"
                    android:background="#6D6D6D" /> <!-- Muted Safe Slate -->

            </LinearLayout>

            <TextView
                android:id="@+id/tvCycleDay1Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Cycle Day 1"
                android:textColor="#8A7A8F"
                android:textSize="10sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cycleProgressBar" />

            <TextView
                android:id="@+id/tvEstDaysLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Est. 28 Days"
                android:textSize="10sp"
                android:textColor="#8A7A8F"
                android:layout_marginTop="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cycleProgressBar" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- LEGEND -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <View android:id="@+id/legendPeriodDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="#C2185B" /> <!-- Period Pink -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Period" android:textSize="12sp" android:textColor="#2D1B33"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/legendOvulationDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="#7C3AED" /> <!-- Accent Purple -->
                    <TextView android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ovulation"
                        android:textSize="12sp"
                        android:textColor="#2D1B33"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <View android:id="@+id/legendFertileDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="#3B7A57" /> <!-- Fertile Sage Green -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Fertile window" android:textSize="12sp" android:textColor="#2D1B33"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <View android:id="@+id/legendPredictedDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="#FBCFE8" /> <!-- Light Soft Pink -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Predicted Period" android:textSize="12sp" android:textColor="#2D1B33"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- SELECTED DAY DETAIL CARD -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/selectedDayCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvSelectedDayFull"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Monday, October 14"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#2D1B33"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvPhaseBadge" />

            <TextView
                android:id="@+id/tvPhaseBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☀ Fertile Window"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#3B7A57"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvSelectedDaySub"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Cycle Day 12 · 14 Days until next period"
                android:textSize="12sp"
                android:textColor="#8A7A8F"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSelectedDayFull" />

            <!-- Energy / Libido / Sleep row -->
            <LinearLayout
                android:id="@+id/dayStatRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSelectedDaySub">

                <!-- Energy card -->
                <LinearLayout
                    android:id="@+id/cardEnergy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="ENERGY"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:textColor="#8A7A8F" />

                    <TextView
                        android:id="@+id/tvEnergyValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="High"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#2D1B33" />

                    <TextView
                        android:id="@+id/tvEnergySource"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="estimated"
                        android:textSize="9sp"
                        android:textColor="#A855F7" />

                </LinearLayout>

                <!-- Libido card -->
                <LinearLayout
                    android:id="@+id/cardLibido"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🤍"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="LIBIDO"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:textColor="#8A7A8F" />

                    <TextView
                        android:id="@+id/tvLibidoValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Normal"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#2D1B33" />

                    <TextView
                        android:id="@+id/tvLibidoSource"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="estimated"
                        android:textSize="9sp"
                        android:textColor="#A855F7" />

                </LinearLayout>

                <!-- Sleep card -->
                <LinearLayout
                    android:id="@+id/cardSleep"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌙"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="SLEEP"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:textColor="#8A7A8F" />

                    <TextView
                        android:id="@+id/tvSleepValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="7.5 hrs"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#2D1B33" />

                    <TextView
                        android:id="@+id/tvSleepSource"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="estimated"
                        android:textSize="9sp"
                        android:textColor="#A855F7" />

                </LinearLayout>

            </LinearLayout>

            <!-- Cervical fluid row -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cervicalRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/dayStatRow">

                <TextView
                    android:id="@+id/iconCervical"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="💧"
                    android:textSize="15sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp"
                    app:layout_constraintStart_toEndOf="@id/iconCervical"
                    app:layout_constraintEnd_toStartOf="@id/tvFertilityChance"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Cervical Fluid" android:textSize="10sp" android:textColor="#8A7A8F" />
                    <TextView android:id="@+id/tvCervicalValue"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Creamy · Low viscosity" android:textSize="13sp"
                        android:textStyle="bold" android:textColor="#2D1B33" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvFertilityChance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chances: High"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#EC4899"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Period Start Section -->
            <LinearLayout
                android:id="@+id/periodStartSection"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:padding="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cervicalRow">

                <!-- Header row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🩸  Period Start"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#2D1B33" />

                    <TextView
                        android:id="@+id/tvPeriodStartStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Not set"
                        android:textSize="11sp"
                        android:textColor="#8A7A8F" />

                </LinearLayout>


                <!-- Log Period Start button -->
                <com.aivigil.periodtracker.widgets.GradientButton
                    android:id="@+id/btnLogPeriodStart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="🩸  Log Period Start" />

            </LinearLayout>

            <!-- Divider -->


            <!-- Edit Log gradient button -->
<!--
            <com.aivigil.periodtracker.widgets.GradientButton
                android:id="@+id/btnEditLog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="📅  Edit Log for Oct 14"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/dividerPeriodLog" />
-->

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- DAILY TIP CARD -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/dailyTipCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="14dp"
            android:padding="14dp">

            <TextView
                android:id="@+id/ivTipImage"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:gravity="center"
                android:text="🌸"
                android:textSize="28sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toEndOf="@id/ivTipImage"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="DAILY TIP" android:textSize="9sp" android:textStyle="bold"
                    android:letterSpacing="0.08" android:textColor="#EC4899" />

                <TextView android:id="@+id/tvTipTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text=""
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#2D1B33" />

                <TextView android:id="@+id/tvTipBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text=""
                    android:textSize="11sp"
                    android:textColor="#8A7A8F"
                    android:maxLines="2"
                    android:ellipsize="end" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>