<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_bg"
    android:paddingBottom="32dp">

    <!-- Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/sheet_handle" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:text="Average cycle length"
        android:textSize="13sp"
        android:textColor="#EC4899"
        android:textStyle="bold"
        android:letterSpacing="0.04" />

    <!-- Selected value -->
    <TextView
        android:id="@+id/tvCycleLengthSelected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="4dp"
        android:text="28 days"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#2D1B33" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F5EEF8"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="24dp" />

    <!-- Number picker scroll -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCycleLength"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="8dp"
        android:overScrollMode="never" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:paddingHorizontal="24dp">

        <TextView
            android:id="@+id/btnCycleLengthCancel"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Cancel"
            android:textSize="15sp"
            android:textColor="#8A7A8F"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/btnCycleLengthOk"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="OK"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#EC4899"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>