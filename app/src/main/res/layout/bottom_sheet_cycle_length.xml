<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_bg"
    android:paddingBottom="@dimen/_32sdp">

    <!-- Handle -->
    <View
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_4sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/_12sdp"
        android:background="@drawable/sheet_handle" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_24sdp"
        android:layout_marginTop="@dimen/_24sdp"
        android:text="Average cycle length"
        android:textSize="@dimen/_11ssp"
        android:textColor="#EC4899"
        android:textStyle="bold"
        android:letterSpacing="0.04" />

    <!-- Selected value -->
    <TextView
        android:id="@+id/tvCycleLengthSelected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_24sdp"
        android:layout_marginTop="@dimen/_4sdp"
        android:text="28 days"
        android:textSize="@dimen/_28ssp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/_1sdp"
        android:background="@color/stroke_card"
        android:layout_marginTop="@dimen/_16sdp"
        android:layout_marginHorizontal="@dimen/_24sdp" />

    <!-- Number picker scroll -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCycleLength"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_220sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:overScrollMode="never" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/_20sdp"
        android:paddingHorizontal="@dimen/_24sdp">

        <TextView
            android:id="@+id/btnCycleLengthCancel"
            android:layout_width="0dp"
            android:layout_height="@dimen/_50sdp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Cancel"
            android:textSize="@dimen/_13ssp"
            android:textColor="@color/text_secondary"
            android:layout_marginEnd="@dimen/_8sdp" />

        <TextView
            android:id="@+id/btnCycleLengthOk"
            android:layout_width="0dp"
            android:layout_height="@dimen/_50sdp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="OK"
            android:textSize="@dimen/_13ssp"
            android:textStyle="bold"
            android:textColor="#EC4899"
            android:layout_marginStart="@dimen/_8sdp" />

    </LinearLayout>

</LinearLayout>