<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:paddingTop="8dp"
    android:paddingBottom="32dp"
    android:paddingHorizontal="24dp">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_drag_handle"/>

    <!-- Sheet title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="How old are you?"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#3D1B2E"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your age helps personalize cycle insights and predictions."
        android:textSize="12sp"
        android:textColor="#8A7A8F"
        android:layout_marginBottom="20dp"/>

    <!-- Age card (white card with shadow) -->
    <LinearLayout
        android:id="@+id/ageCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="28dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="24dp">

        <!-- Big age number -->
        <TextView
            android:id="@+id/tvAgeValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="27"
            android:textSize="56sp"
            android:textStyle="bold"
            android:textColor="#E63A5E"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="YEARS YOUNG"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textColor="#8A7A8F"/>

        <!-- Slider -->
        <com.google.android.material.slider.Slider
            android:id="@+id/ageSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:valueFrom="12"
            android:valueTo="55"
            android:stepSize="1"
            android:value="27"
            app:thumbColor="#E63A5E"
            app:trackColorActive="#E63A5E"
            app:trackColorInactive="#F0DDE3"
            app:labelBehavior="gone"/>

        <!-- Min / max labels -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start"
                android:text="12"
                android:textSize="11sp"
                android:textColor="#8A7A8F"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="55+"
                android:textSize="11sp"
                android:textColor="#8A7A8F"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="2">

        <Button
            android:id="@+id/btnSheetCancel"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Cancel"
            android:textColor="#6B7280"
            app:cornerRadius="14dp"/>

        <Button
            android:id="@+id/btnSheetSave"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Save"
            android:textColor="#FFFFFF"
            android:backgroundTint="#EC4899"
            app:cornerRadius="14dp"/>

    </LinearLayout>

    <!-- Privacy note -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="🔒 Stored securely on-device"
        android:textSize="11sp"
        android:textColor="#8A7A8F"/>

</LinearLayout>