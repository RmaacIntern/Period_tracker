<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_bg"
    android:paddingTop="@dimen/_7sdp"
    android:paddingBottom="@dimen/_27sdp"
    android:paddingHorizontal="@dimen/_20sdp">

    <!-- Drag handle -->
    <View
        android:layout_width="@dimen/_34sdp"
        android:layout_height="@dimen/_3sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/_17sdp"
        android:background="@drawable/bg_drag_handle"/>

    <!-- Sheet title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="How old are you?"
        android:textSize="@dimen/_15ssp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="@dimen/_3sdp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your age helps personalize cycle insights and predictions."
        android:textSize="@dimen/_10ssp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="@dimen/_17sdp"/>

    <!-- Age card (white card with shadow) -->
    <LinearLayout
        android:id="@+id/ageCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="@dimen/_24sdp"
        android:paddingBottom="@dimen/_14sdp"
        android:paddingHorizontal="@dimen/_17sdp"
        android:layout_marginBottom="@dimen/_20sdp">

        <!-- Big age number -->
        <TextView
            android:id="@+id/tvAgeValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="27"
            android:textSize="@dimen/_48ssp"
            android:textStyle="bold"
            android:textColor="#E63A5E"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:text="YEARS YOUNG"
            android:textSize="@dimen/_9ssp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textColor="@color/text_secondary"/>

        <!-- Slider -->
        <com.google.android.material.slider.Slider
            android:id="@+id/ageSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_17sdp"
            android:valueFrom="12"
            android:valueTo="55"
            android:stepSize="1"
            android:value="27"
            app:thumbColor="#E63A5E"
            app:trackColorActive="#E63A5E"
            app:trackColorInactive="@color/slider_track_inactive"
            app:labelBehavior="gone"/>

        <!-- Min / max labels -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start"
                android:text="12"
                android:textSize="@dimen/_9ssp"
                android:textColor="@color/text_secondary"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="55+"
                android:textSize="@dimen/_9ssp"
                android:textColor="@color/text_secondary"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="2">

        <Button
            android:id="@+id/btnSheetCancel"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/_44sdp"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/_7sdp"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            app:cornerRadius="@dimen/_12sdp"/>

        <Button
            android:id="@+id/btnSheetSave"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="@dimen/_44sdp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/_7sdp"
            android:text="Save"
            android:textColor="#FFFFFF"
            android:backgroundTint="#EC4899"
            app:cornerRadius="@dimen/_12sdp"/>

    </LinearLayout>

    <!-- Privacy note -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_14sdp"
        android:gravity="center"
        android:text="🔒 Stored securely on-device"
        android:textSize="@dimen/_9ssp"
        android:textColor="@color/text_secondary"/>

</LinearLayout>