<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/onboarding2Root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/_20sdp"
    tools:context=".onboarding.OnboardingFragment2">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20sdp"
        android:text="How old are you?"
        android:textSize="@dimen/_20ssp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_7sdp"
        android:text="Your age helps Period Tracker personalize your cycle insights and predictions."
        android:textSize="@dimen/_11ssp"
        android:textColor="@color/text_secondary"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <LinearLayout
        android:id="@+id/ageCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_24sdp"
        android:paddingTop="@dimen/_24sdp"
        android:paddingBottom="@dimen/_14sdp"
        android:paddingHorizontal="@dimen/_17sdp"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

        <TextView
            android:id="@+id/tvAgeValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="27"
            android:textSize="@dimen/_40ssp"
            android:textStyle="bold"
            android:textColor="#E63A5E" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:text="YEARS YOUNG"
            android:textSize="@dimen/_9ssp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.slider.Slider
            android:id="@+id/ageSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_17sdp"
            android:valueFrom="12"
            android:valueTo="55"
            android:stepSize="1"
            android:value="27"
            app:thumbColor="#E63A5E"
            app:trackColorActive="#E63A5E"
            app:trackColorInactive="@color/slider_track_inactive"
            app:labelBehavior="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMinAge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start"
                android:text="12"
                android:textSize="@dimen/_9ssp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tvMaxAge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="55+"
                android:textSize="@dimen/_9ssp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/nativeAdContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_7sdp"
        android:layout_marginBottom="@dimen/_25sdp"
        android:background="@drawable/bg_ad_card"
        android:elevation="@dimen/_1sdp"
        app:layout_constraintBottom_toTopOf="@id/tvFooterNote"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ageCard" />

    <TextView
        android:id="@+id/tvFooterNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_20sdp"
        android:gravity="center"
        android:text="🔒 Kept confidential and securely stored on-device"
        android:textSize="@dimen/_9ssp"
        android:textColor="@color/text_secondary"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>