<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_bg"
    android:paddingBottom="@dimen/_27sdp">

    <!-- Handle -->
    <View
        android:layout_width="@dimen/_34sdp"
        android:layout_height="@dimen/_3sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/_10sdp"
        android:background="@drawable/sheet_handle" />

    <!-- Question -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_20sdp"
        android:layout_marginTop="@dimen/_20sdp"
        android:text="Log Period Start"
        android:textSize="@dimen/_15ssp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <!-- Selected date row -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_20sdp"
        android:layout_marginTop="@dimen/_7sdp">

        <TextView
            android:id="@+id/tvPeriodStartDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Select a date"
            android:textSize="@dimen/_22ssp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnPeriodStartEdit"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/btnPeriodStartEdit"
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp"
            android:gravity="center"
            android:text="✏"
            android:textSize="@dimen/_13ssp"
            android:textColor="#FFFFFF"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/_1sdp"
        android:background="@color/stroke_card"
        android:layout_marginTop="@dimen/_10sdp" />

    <!-- Month nav row -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/_20sdp"
        android:paddingTop="@dimen/_12sdp"
        android:paddingBottom="@dimen/_7sdp">

        <TextView
            android:id="@+id/tvPeriodStartMonth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="September 2026"
            android:textSize="@dimen/_13ssp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:drawablePadding="@dimen/_3sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/btnPeriodStartPrev"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:gravity="center"
                android:text="‹"
                android:textSize="@dimen/_16ssp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/btnPeriodStartNext"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:gravity="center"
                android:text="›"
                android:textSize="@dimen/_16ssp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Weekday headers S M T W T F S -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_14sdp">

        <TextView android:layout_width="0dp" android:layout_height="@dimen/_27sdp"
            android:layout_weight="1" android:gravity="center"
            android:text="S" android:textSize="@dimen/_10ssp" android:textColor="@color/text_secondary" />
        <TextView android:layout_width="0dp" android:layout_height="@dimen/_27sdp"
            android:layout_weight="1" android:gravity="center"
            android:text="M" android:textSize="@dimen/_10ssp" android:textColor="@color/text_secondary" />
        <TextView android:layout_width="0dp" android:layout_height="@dimen/_27sdp"
            android:layout_weight="1" android:gravity="center"
            android:text="T" android:textSize="@dimen/_10ssp" android:textColor="@color/text_secondary" />
        <TextView android:layout_width="0dp" android:layout_height="@dimen/_27sdp"
            android:layout_weight="1" android:gravity="center"
            android:text="W" android:textSize="@dimen/_10ssp" android:textColor="@color/text_secondary" />
        <TextView android:layout_width="0dp" android:layout_height="@dimen/_27sdp"
            android:layout_weight="1" android:gravity="center"
            android:text="T" android:textSize="@dimen/_10ssp" android:textColor="@color/text_secondary" />
        <TextView android:layout_width="0dp" android:layout_height="@dimen/_27sdp"
            android:layout_weight="1" android:gravity="center"
            android:text="F" android:textSize="@dimen/_10ssp" android:textColor="@color/text_secondary" />
        <TextView android:layout_width="0dp" android:layout_height="@dimen/_27sdp"
            android:layout_weight="1" android:gravity="center"
            android:text="S" android:textSize="@dimen/_10ssp" android:textColor="@color/text_secondary" />
    </LinearLayout>

    <!-- Calendar grid -->
    <com.aivigil.periodtracker.calendar.SheetCalendarView
        android:id="@+id/periodStartCalendar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_240sdp"
        android:layout_marginHorizontal="@dimen/_14sdp" />

    <!-- Recent periods — edit or delete wrong entries -->
    <LinearLayout
        android:id="@+id/recentPeriodsSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="@dimen/_20sdp"
        android:layout_marginTop="@dimen/_14sdp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recent periods"
            android:textSize="@dimen/_10ssp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="@dimen/_5sdp" />

        <LinearLayout
            android:id="@+id/recentPeriodsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

    <!-- Cancel / OK -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/_7sdp"
        android:paddingHorizontal="@dimen/_20sdp">

        <TextView
            android:id="@+id/btnPeriodStartCancel"
            android:layout_width="0dp"
            android:layout_height="@dimen/_44sdp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Cancel"
            android:textSize="@dimen/_13ssp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/btnPeriodStartOk"
            android:layout_width="0dp"
            android:layout_height="@dimen/_44sdp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Log Period Start"
            android:textSize="@dimen/_13ssp"
            android:textStyle="bold"
            android:textColor="#EC4899" />

    </LinearLayout>

</LinearLayout>