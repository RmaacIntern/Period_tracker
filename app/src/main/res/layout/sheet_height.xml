<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_bg"
    android:paddingTop="@dimen/_7sdp"
    android:paddingBottom="@dimen/_27sdp"
    android:paddingHorizontal="@dimen/_20sdp">

    <!-- Drag handle -->
    <View
        android:layout_width="@dimen/_34sdp"
        android:layout_height="@dimen/_3sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/_17sdp"
        android:background="@drawable/bg_drag_handle"/>

    <!-- Sheet title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Update Height"
        android:textSize="@dimen/_15ssp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="@dimen/_3sdp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Height helps personalize your cycle insights and health information."
        android:textSize="@dimen/_10ssp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="@dimen/_17sdp"/>

    <!-- Height card -->
    <LinearLayout
        android:id="@+id/heightCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_15sdp"
        android:layout_marginBottom="@dimen/_20sdp">

        <!-- Label + value row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📏 Height"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>

            <TextView
                android:id="@+id/tvHeightValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="162 cm"
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold"
                android:textColor="#E63A5E"/>

        </LinearLayout>

        <!-- Slider -->
        <com.google.android.material.slider.Slider
            android:id="@+id/heightSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_7sdp"
            android:valueFrom="130"
            android:valueTo="210"
            android:stepSize="1"
            android:value="162"
            app:thumbColor="#E63A5E"
            app:trackColorActive="#E63A5E"
            app:trackColorInactive="@color/slider_track_inactive"
            app:labelBehavior="gone"/>

        <!-- Min / max labels -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="130 cm"
                android:textSize="@dimen/_9ssp"
                android:textColor="@color/text_secondary"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="210 cm"
                android:textSize="@dimen/_9ssp"
                android:textColor="@color/text_secondary"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="2">

        <Button
            android:id="@+id/btnSheetCancel"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/_44sdp"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/_7sdp"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            app:cornerRadius="@dimen/_12sdp"/>

        <Button
            android:id="@+id/btnSheetSave"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="@dimen/_44sdp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/_7sdp"
            android:text="Save"
            android:textColor="#FFFFFF"
            android:backgroundTint="#EC4899"
            app:cornerRadius="@dimen/_12sdp"/>

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_14sdp"
        android:gravity="center"
        android:text="🔒 Stored securely on-device"
        android:textSize="@dimen/_9ssp"
        android:textColor="@color/text_secondary"/>

</LinearLayout>