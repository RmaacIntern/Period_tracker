<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/onboarding3Root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="24dp"
    tools:context=".onboarding.OnboardingFragment3">

    <!-- ✅ FIX — #3D1B2E → @color/text_primary -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="A little about\nyour body"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ✅ FIX — #8A7A8F → @color/text_secondary -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Height and weight help personalize your cycle insights and health information. No judgment here, ever."
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <!-- heightCard background set in Kotlin via ThemeHelper.cardBg() -->
    <LinearLayout
        android:id="@+id/heightCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:padding="18dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- ✅ FIX — #2D1B33 → @color/text_primary -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📏 Height"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <!-- brand pink — kept hardcoded -->
            <TextView
                android:id="@+id/tvHeightValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="162 cm"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#E63A5E" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/heightSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:valueFrom="130"
            android:valueTo="210"
            android:stepSize="1"
            android:value="162"
            app:thumbColor="#E63A5E"
            app:trackColorActive="#E63A5E"
            app:trackColorInactive="@color/slider_track_inactive"
            app:labelBehavior="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ✅ FIX — #8A7A8F → @color/text_secondary -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="130 cm"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />

            <!-- ✅ FIX — #8A7A8F → @color/text_secondary -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="210 cm"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- weightCard background set in Kotlin via ThemeHelper.cardBg() -->
    <LinearLayout
        android:id="@+id/weightCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:padding="18dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/heightCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- ✅ FIX — #2D1B33 → @color/text_primary -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚖️ Weight"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <!-- brand pink — kept hardcoded -->
            <TextView
                android:id="@+id/tvWeightValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="60.0 kg"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#E63A5E" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/weightSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:valueFrom="35"
            android:valueTo="140"
            android:stepSize="0.5"
            android:value="60"
            app:thumbColor="#E63A5E"
            app:trackColorActive="#E63A5E"
            app:trackColorInactive="@color/slider_track_inactive"
            app:labelBehavior="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ✅ FIX — #8A7A8F → @color/text_secondary -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="35 kg"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />

            <!-- ✅ FIX — #8A7A8F → @color/text_secondary -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="140 kg"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- ✅ FIX — #8A7A8F → @color/text_secondary -->
    <TextView
        android:id="@+id/tvFooterNote"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:text="🔒 Kept confidential and securely stored on-device"
        android:textSize="11sp"
        android:textColor="@color/text_secondary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>