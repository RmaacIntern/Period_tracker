<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/onboarding4Root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/_20sdp"
    android:paddingBottom="@dimen/_20sdp"
    tools:context=".onboarding.OnboardingFragment4">

    <FrameLayout
        android:id="@+id/heartIconCircle"
        android:layout_width="@dimen/_48sdp"
        android:layout_height="@dimen/_48sdp"
        android:layout_marginTop="@dimen/_20sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="💗"
            android:textSize="@dimen/_18ssp" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_14sdp"
        android:text="Anything your body\nlives with?"
        android:textSize="@dimen/_18ssp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        app:layout_constraintTop_toBottomOf="@id/heartIconCircle" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_7sdp"
        android:text="Period Tracker quietly adapts its predictions, cycle insights, and helpful tips around your health. Pick all that apply, or none."
        android:textSize="@dimen/_11ssp"
        android:textColor="@color/text_secondary"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/conditionsChipGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_17sdp"
        app:chipSpacingHorizontal="@dimen/_7sdp"
        app:chipSpacingVertical="@dimen/_7sdp"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipPcos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/ConditionChip"
            android:text="PCOS" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipEndometriosis"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/ConditionChip"
            android:text="Endometriosis" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipThyroid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/ConditionChip"
            android:text="Thyroid issues" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipDiabetes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/ConditionChip"
            android:text="Diabetes" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipBloodPressure"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/ConditionChip"
            android:text="High blood pressure" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAnemia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/ConditionChip"
            android:text="Anemia" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipMigraines"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/ConditionChip"
            android:text="Migraines" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAnxiety"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/ConditionChip"
            android:text="Anxiety or low mood" />

    </com.google.android.material.chip.ChipGroup>

    <com.google.android.material.chip.Chip
        android:id="@+id/chipNoneOfThese"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/ConditionChip"
        android:layout_marginTop="@dimen/_14sdp"
        android:text="🍃  None of these"
        android:textAlignment="center"
        app:chipStartPadding="@dimen/_14sdp"
        app:layout_constraintTop_toBottomOf="@id/conditionsChipGroup" />

    <TextView
        android:id="@+id/tvFooterNote"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_20sdp"
        android:gravity="center"
        android:text="🔒 Kept confidential and securely stored on-device"
        android:textSize="@dimen/_9ssp"
        android:textColor="@color/text_secondary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>