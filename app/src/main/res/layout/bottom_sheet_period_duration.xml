<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_bg"
    android:paddingBottom="32dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/sheet_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:text="Period duration"
        android:textSize="13sp"
        android:textColor="#EC4899"
        android:textStyle="bold"
        android:letterSpacing="0.04" />

    <TextView
        android:id="@+id/tvPeriodDurSelected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="4dp"
        android:text="5 days"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/surface_muted"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="24dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPeriodDuration"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="8dp"
        android:overScrollMode="never" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:paddingHorizontal="24dp">

        <TextView
            android:id="@+id/btnPeriodDurCancel"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Cancel"
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/btnPeriodDurOk"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="OK"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#EC4899"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>