<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:fillViewport="true"
    android:background="@color/surface_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/_14sdp"
        android:paddingEnd="@dimen/_14sdp"
        android:paddingBottom="@dimen/_27sdp">

        <!-- TOP BAR -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_48sdp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Insights"
                android:textSize="@dimen/_18ssp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- PAGE TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HEALTH &amp; CYCLE ANALYTICS"
            android:textSize="@dimen/_8ssp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textColor="@color/text_secondary" />

        <!-- STAT CARDS ROW 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_14sdp"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardAvgCycle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/_5sdp"
                android:padding="@dimen/_12sdp">

                <TextView android:id="@+id/lblAvgCycle"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:text="Avg Cycle"
                    android:textSize="@dimen/_10ssp"
                    android:textColor="@color/text_secondary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/iconAvgCycle" />

                <TextView android:id="@+id/iconAvgCycle"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:gravity="center" android:text="🔄"
                    android:textSize="@dimen/_11ssp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView android:id="@+id/tvAvgCycleValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_7sdp"
                    android:text="28 Days"
                    android:textSize="@dimen/_18ssp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:ellipsize="end"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/lblAvgCycle" />

                <TextView android:id="@+id/tvAvgCycleSub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:text="● ±1.2d (Regular)"
                    android:textSize="@dimen/_9ssp"
                    android:textColor="#16A34A"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:ellipsize="end"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvAvgCycleValue" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardAvgPeriod"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/_5sdp"
                android:padding="@dimen/_12sdp">

                <TextView android:id="@+id/lblAvgPeriod"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:text="Avg Period"
                    android:textSize="@dimen/_10ssp"
                    android:textColor="@color/text_secondary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/iconAvgPeriod" />

                <TextView android:id="@+id/iconAvgPeriod"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:gravity="center" android:text="💧"
                    android:textSize="@dimen/_11ssp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView android:id="@+id/tvAvgPeriodValue"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_7sdp" android:text="5 Days"
                    android:textSize="@dimen/_18ssp" android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:ellipsize="end"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/lblAvgPeriod" />

                <TextView android:id="@+id/tvAvgPeriodSub"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_3sdp" android:text="Typical 4–6 days"
                    android:textSize="@dimen/_9ssp"
                    android:textColor="@color/text_secondary"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:ellipsize="end"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvAvgPeriodValue" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

        <!-- STAT CARDS ROW 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardLuteal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/_5sdp"
                android:padding="@dimen/_12sdp">

                <TextView android:id="@+id/lblLuteal"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:text="Luteal Phase"
                    android:textSize="@dimen/_10ssp"
                    android:textColor="@color/text_secondary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/iconLuteal" />

                <TextView android:id="@+id/iconLuteal"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:gravity="center" android:text="🌙"
                    android:textSize="@dimen/_11ssp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView android:id="@+id/tvLutealValue"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_7sdp" android:text="14 Days"
                    android:textSize="@dimen/_18ssp" android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:ellipsize="end"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/lblLuteal" />

                <TextView android:id="@+id/tvLutealSub"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_3sdp" android:text="● Consistent"
                    android:textSize="@dimen/_9ssp" android:textColor="#16A34A"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:ellipsize="end"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvLutealValue" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardSymptomPeak"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/_5sdp"
                android:padding="@dimen/_12sdp">

                <TextView android:id="@+id/lblSymptomPeak"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:text="Symptom Peak"
                    android:textSize="@dimen/_10ssp"
                    android:textColor="@color/text_secondary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/iconSymptom" />

                <TextView android:id="@+id/iconSymptom"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:gravity="center" android:text="💗"
                    android:textSize="@dimen/_11ssp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView android:id="@+id/tvSymptomPeakValue"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_7sdp" android:text="Day 27"
                    android:textSize="@dimen/_18ssp" android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:ellipsize="end"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/lblSymptomPeak" />

                <TextView android:id="@+id/tvSymptomPeakSub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:text="Mild fatigue &amp; cramps"
                    android:textSize="@dimen/_9ssp"
                    android:textColor="@color/text_secondary"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:ellipsize="end"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvSymptomPeakValue" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

        <!-- Cycle History Card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cycleHistoryCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:padding="@dimen/_15sdp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tvCycleHistoryIcon"
                android:layout_width="@dimen/_36sdp"
                android:layout_height="@dimen/_36sdp"
                android:gravity="center"
                android:text="🔄"
                android:textColor="#EC4899"
                android:textSize="@dimen/_15ssp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvCycleHistoryTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:text="Cycle History"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/tvCycleHistoryIcon"
                app:layout_constraintTop_toTopOf="@id/tvCycleHistoryIcon"
                app:layout_constraintEnd_toStartOf="@id/tvHistoryArrow" />

            <TextView
                android:id="@+id/tvCycleHistorySub"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:text="Past cycles, regularity &amp; flow patterns"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_9ssp"
                app:layout_constraintStart_toStartOf="@id/tvCycleHistoryTitle"
                app:layout_constraintTop_toBottomOf="@id/tvCycleHistoryTitle"
                app:layout_constraintEnd_toStartOf="@id/tvHistoryArrow" />

            <ImageView
                android:id="@+id/tvHistoryArrow"
                android:layout_width="@dimen/_27sdp"
                android:layout_height="@dimen/_27sdp"
                android:gravity="center"
                android:src="@drawable/ic_next"
                android:background="@drawable/bg_arrow_shadow"
                android:elevation="@dimen/_3sdp"
                android:layout_marginEnd="@dimen/_2sdp"
                android:padding="@dimen/_2sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvCycleHistoryIcon"
                app:layout_constraintBottom_toBottomOf="@id/tvCycleHistoryIcon" />

            <TextView
                android:id="@+id/tvDailyTrackingLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_14sdp"
                android:text="• Daily tracking"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_9ssp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvCycleHistoryIcon" />

            <TextView
                android:id="@+id/tvLastUpdatedLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_14sdp"
                android:text="Updated today"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_9ssp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvCycleHistoryIcon" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- PHASE GUIDE CARD -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/phaseGuideCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:padding="@dimen/_14sdp">

            <TextView android:id="@+id/iconPhaseGuide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/_13ssp"
                android:textColor="#A855F7"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView android:id="@+id/tvPhaseGuideTitle"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:text="Follicular Phase Guide"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginStart="@dimen/_7sdp"
                app:layout_constraintStart_toEndOf="@id/iconPhaseGuide"
                app:layout_constraintEnd_toStartOf="@id/tvPhaseDaysBadge"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="@id/iconPhaseGuide" />

            <TextView android:id="@+id/tvPhaseDaysBadge"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Days 6–13"
                android:textSize="@dimen/_9ssp"
                android:textStyle="bold"
                android:textColor="@color/brand_purple_deep"
                android:paddingHorizontal="@dimen/_8sdp"
                android:paddingVertical="@dimen/_3sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView android:id="@+id/tvPhaseGuideBody"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Estrogen levels rise steadily toward ovulation. Expect natural boosts in focus, mental endurance, and restorative deep sleep. Prioritize strength training and complex whole carbohydrates this week."
                android:textSize="@dimen/_11ssp"
                android:textColor="@color/text_primary"
                android:lineSpacingExtra="@dimen/_2sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iconPhaseGuide" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- COMMON CYCLE PATTERNS CARD -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cyclePatternsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:padding="@dimen/_14sdp">

            <TextView android:id="@+id/tvPatternsTitle"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:text="Common Cycle Patterns"
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnPatternsInfo" />

            <TextView android:id="@+id/btnPatternsInfo"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:gravity="center" android:text="ⓘ"
                android:textSize="@dimen/_13ssp"
                android:textColor="@color/text_secondary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView android:id="@+id/tvPatternsSub"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:text="Reported during days 25–28"
                android:textSize="@dimen/_9ssp"
                android:textColor="@color/text_secondary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvPatternsTitle" />

            <!-- Cramping row -->
            <TextView android:id="@+id/lblCramping"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:text="🔴 Abdominal Cramping"
                android:textSize="@dimen/_11ssp"
                android:textColor="@color/text_primary"
                android:layout_marginTop="@dimen/_14sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvCrampingPct"
                app:layout_constraintTop_toBottomOf="@id/tvPatternsSub" />

            <TextView android:id="@+id/tvCrampingPct"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="60%"
                android:textSize="@dimen/_11ssp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="@dimen/_14sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvPatternsSub" />

            <ProgressBar android:id="@+id/barCramping"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="0dp" android:layout_height="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_5sdp" android:progress="60"
                android:progressTint="#EC4899"
                android:progressBackgroundTint="@color/surface_muted"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lblCramping" />

            <!-- Fatigue row -->
            <TextView android:id="@+id/lblFatigue"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:text="🌙 Lethargy &amp; Fatigue"
                android:textSize="@dimen/_11ssp"
                android:textColor="@color/text_primary"
                android:layout_marginTop="@dimen/_12sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvFatiguePct"
                app:layout_constraintTop_toBottomOf="@id/barCramping" />

            <TextView android:id="@+id/tvFatiguePct"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="45%"
                android:textSize="@dimen/_11ssp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="@dimen/_12sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/barCramping" />

            <ProgressBar android:id="@+id/barFatigue"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="0dp" android:layout_height="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_5sdp" android:progress="45"
                android:progressTint="#A855F7"
                android:progressBackgroundTint="@color/surface_muted"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lblFatigue" />

            <!-- Headache row -->
            <TextView android:id="@+id/lblHeadache"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:text="💡 Mild Headaches"
                android:textSize="@dimen/_11ssp"
                android:textColor="@color/text_primary"
                android:layout_marginTop="@dimen/_12sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvHeadachePct"
                app:layout_constraintTop_toBottomOf="@id/barFatigue" />

            <TextView android:id="@+id/tvHeadachePct"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="20%"
                android:textSize="@dimen/_11ssp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="@dimen/_12sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/barFatigue" />

            <ProgressBar android:id="@+id/barHeadache"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="0dp" android:layout_height="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_5sdp" android:progress="20"
                android:progressTint="@color/text_secondary"
                android:progressBackgroundTint="@color/surface_muted"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lblHeadache" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- PHYSICIAN EXPORT CARD -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/exportCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:padding="@dimen/_14sdp">

            <TextView
                android:id="@+id/iconExport"
                android:layout_width="@dimen/_38sdp"
                android:layout_height="@dimen/_38sdp"
                android:gravity="center"
                android:text="📋"
                android:textSize="@dimen/_16ssp"
                app:layout_constraintBottom_toBottomOf="@+id/tvExportBody"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvExportTitle" />

            <TextView
                android:id="@+id/tvExportTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:text="Physician-Ready Export"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/iconExport"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView android:id="@+id/tvExportBody"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:layout_marginStart="@dimen/_10sdp"
                android:text="Summarizes ovulation markers, luteal variance, and pain frequency formatted for OB/GYN consultations."
                android:textSize="@dimen/_10ssp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="@dimen/_2sdp"
                app:layout_constraintStart_toEndOf="@id/iconExport"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvExportTitle" />

            <Button
                android:id="@+id/btnDownloadReport"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="@dimen/_44sdp"
                android:layout_marginTop="@dimen/_14sdp"
                android:text="Download Cycle Report (PDF)"
                android:textColor="#FFFFFF"
                android:backgroundTint="#EC4899"
                app:cornerRadius="@dimen/_12sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvExportBody" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>