<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/_32sdp"
    android:background="@drawable/bottom_sheet_bg">

    <!-- Handle -->
    <View
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_4sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/_12sdp"
        android:layout_marginBottom="@dimen/_20sdp"
        android:background="@drawable/sheet_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_20sdp"
        android:layout_marginBottom="@dimen/_16sdp"
        android:text="Activity Level"
        android:textSize="@dimen/_15ssp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <!-- Gentle -->
    <LinearLayout
        android:id="@+id/cardGentle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_16sdp"
        android:layout_marginBottom="@dimen/_10sdp"
        android:padding="@dimen/_16sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvGentleLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gentle"
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvGentleDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:text="Light walks, yoga, low-impact movement"
                android:textSize="@dimen/_10ssp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/checkGentle"
            android:layout_width="@dimen/_24sdp"
            android:layout_height="@dimen/_24sdp">

            <ImageView
                android:id="@+id/ivCheckGentle"
                android:layout_width="@dimen/_14sdp"
                android:layout_height="@dimen/_14sdp"
                android:layout_gravity="center"
                android:src="@drawable/ic_uncheck"
                android:contentDescription="Selection state" />
        </FrameLayout>
    </LinearLayout>

    <!-- Balanced -->
    <LinearLayout
        android:id="@+id/cardBalanced"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_16sdp"
        android:layout_marginBottom="@dimen/_10sdp"
        android:padding="@dimen/_16sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBalancedLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Balanced"
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvBalancedDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:text="Mix of rest and moderate exercise"
                android:textSize="@dimen/_10ssp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/checkBalanced"
            android:layout_width="@dimen/_24sdp"
            android:layout_height="@dimen/_24sdp">

            <ImageView
                android:id="@+id/ivCheckBalanced"
                android:layout_width="@dimen/_14sdp"
                android:layout_height="@dimen/_14sdp"
                android:layout_gravity="center"
                android:src="@drawable/ic_uncheck"
                android:contentDescription="Selection state" />
        </FrameLayout>
    </LinearLayout>

    <!-- Very Active -->
    <LinearLayout
        android:id="@+id/cardActive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_16sdp"
        android:layout_marginBottom="@dimen/_10sdp"
        android:padding="@dimen/_16sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvActiveLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Very Active"
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvActiveDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:text="Intense workouts, sports or high daily activity"
                android:textSize="@dimen/_10ssp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/checkActive"
            android:layout_width="@dimen/_24sdp"
            android:layout_height="@dimen/_24sdp">

            <ImageView
                android:id="@+id/ivCheckActive"
                android:layout_width="@dimen/_14sdp"
                android:layout_height="@dimen/_14sdp"
                android:layout_gravity="center"
                android:src="@drawable/ic_uncheck"
                android:contentDescription="Selection state" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>