<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="32dp"
    android:background="@drawable/bottom_sheet_bg">

    <!-- Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/sheet_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="16dp"
        android:text="Activity Level"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <!-- Gentle -->
    <LinearLayout
        android:id="@+id/cardGentle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="10dp"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvGentleLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gentle"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvGentleDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Light walks, yoga, low-impact movement"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/checkGentle"
            android:layout_width="24dp"
            android:layout_height="24dp">

            <ImageView
                android:id="@+id/ivCheckGentle"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_uncheck"
                android:contentDescription="Selection state" />
        </FrameLayout>
    </LinearLayout>

    <!-- Balanced -->
    <LinearLayout
        android:id="@+id/cardBalanced"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="10dp"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBalancedLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Balanced"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvBalancedDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Mix of rest and moderate exercise"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/checkBalanced"
            android:layout_width="24dp"
            android:layout_height="24dp">

            <ImageView
                android:id="@+id/ivCheckBalanced"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_uncheck"
                android:contentDescription="Selection state" />
        </FrameLayout>
    </LinearLayout>

    <!-- Very Active -->
    <LinearLayout
        android:id="@+id/cardActive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="10dp"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvActiveLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Very Active"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvActiveDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Intense workouts, sports or high daily activity"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/checkActive"
            android:layout_width="24dp"
            android:layout_height="24dp">

            <ImageView
                android:id="@+id/ivCheckActive"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_uncheck"
                android:contentDescription="Selection state" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>