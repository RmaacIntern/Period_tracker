<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/onboarding5Root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="24dp"
    tools:context=".onboarding.OnboardingFragment5">

    <FrameLayout
        android:id="@+id/moveIconCircle"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_running"
            android:contentDescription="Movement icon" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="How does your body\nlike to move?"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#3D1B2E"
        app:layout_constraintTop_toBottomOf="@id/moveIconCircle" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Period Tracker matches workout and rest suggestions to each cycle phase."
        android:textSize="13sp"
        android:textColor="#8A7A8F"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <!-- Gentle -->
    <LinearLayout
        android:id="@+id/cardGentle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/gentle"
            android:contentDescription="Gentle icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvGentleLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gentle"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#2D1B33" />

            <TextView
                android:id="@+id/tvGentleDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Walks, stretching, low-key days"
                android:textSize="11sp"
                android:textColor="#8A7A8F" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/checkGentle"
            android:layout_width="24dp"
            android:layout_height="24dp">

            <ImageView
                android:id="@+id/ivCheckGentle"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_uncheck"
                android:contentDescription="Selection state" />
        </FrameLayout>
    </LinearLayout>

    <!-- Balanced -->
    <LinearLayout
        android:id="@+id/cardBalanced"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/cardGentle">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/balance"
            android:contentDescription="Balanced icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBalancedLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Balanced"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/tvBalancedDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Regular movement, some workouts"
                android:textSize="11sp"
                android:textColor="#F5E6F0" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/checkBalanced"
            android:layout_width="24dp"
            android:layout_height="24dp">

            <ImageView
                android:id="@+id/ivCheckBalanced"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check"
                android:contentDescription="Selection state" />
        </FrameLayout>
    </LinearLayout>

    <!-- Very active -->
    <LinearLayout
        android:id="@+id/cardActive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/cardBalanced">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/active"
            android:contentDescription="Very active icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvActiveLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Very active"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#2D1B33" />

            <TextView
                android:id="@+id/tvActiveDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Training most days, love to sweat"
                android:textSize="11sp"
                android:textColor="#8A7A8F" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/checkActive"
            android:layout_width="24dp"
            android:layout_height="24dp">

            <ImageView
                android:id="@+id/ivCheckActive"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_uncheck"
                android:contentDescription="Selection state" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvFooterNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:text="🔒 Kept confidential and securely stored on-device"
        android:textSize="11sp"
        android:textColor="#8A7A8F"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>