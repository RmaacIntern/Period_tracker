<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@color/surface_card"
    android:padding="@dimen/_4sdp"
    android:elevation="@dimen/_10sdp"
    android:paddingStart="@dimen/_7sdp"
    android:paddingEnd="@dimen/_7sdp"
    android:paddingTop="@dimen/_8sdp"
    android:paddingBottom="@dimen/_8sdp"
    android:gravity="center_vertical"
    android:minHeight="@dimen/_54sdp">

    <!-- Home -->
    <LinearLayout
        android:id="@+id/navHome"
        android:layout_width="0dp"
        android:layout_height="@dimen/_38sdp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="@dimen/_7sdp"
        android:paddingEnd="@dimen/_7sdp">

        <ImageView
            android:id="@+id/iconHome"
            android:layout_width="@dimen/_17sdp"
            android:layout_height="@dimen/_17sdp"
            android:src="@drawable/ic_nav_home"
            android:contentDescription="Home"
            android:layout_gravity="center_vertical" />

        <TextView
            android:id="@+id/labelHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_4sdp"
            android:text="Home"
            android:textSize="@dimen/_10ssp"
            android:textStyle="bold"
            android:maxLines="1"
            android:visibility="invisible"
            android:textColor="@android:color/white"
            android:layout_gravity="center_vertical" />
    </LinearLayout>

    <!-- Calendar -->
    <LinearLayout
        android:id="@+id/navCalendar"
        android:layout_width="0dp"
        android:layout_height="@dimen/_38sdp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="@dimen/_7sdp"
        android:paddingEnd="@dimen/_7sdp">

        <ImageView
            android:id="@+id/iconCalendar"
            android:layout_width="@dimen/_17sdp"
            android:layout_height="@dimen/_17sdp"
            android:src="@drawable/ic_nav_calendar"
            android:contentDescription="Calendar"
            android:layout_gravity="center_vertical" />

        <TextView
            android:id="@+id/labelCalendar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_4sdp"
            android:text="Calendar"
            android:textSize="@dimen/_10ssp"
            android:textStyle="bold"
            android:maxLines="1"
            android:visibility="invisible"
            android:textColor="@android:color/white"
            android:layout_gravity="center_vertical" />
    </LinearLayout>

    <!-- Insights -->
    <LinearLayout
        android:id="@+id/navInsights"
        android:layout_width="0dp"
        android:layout_height="@dimen/_38sdp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="@dimen/_7sdp"
        android:paddingEnd="@dimen/_7sdp">

        <ImageView
            android:id="@+id/iconInsights"
            android:layout_width="@dimen/_17sdp"
            android:layout_height="@dimen/_17sdp"
            android:src="@drawable/ic_nav_insights"
            android:contentDescription="Insights"
            android:layout_gravity="center_vertical" />

        <TextView
            android:id="@+id/labelInsights"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_4sdp"
            android:text="Insights"
            android:textSize="@dimen/_10ssp"
            android:textStyle="bold"
            android:maxLines="1"
            android:visibility="invisible"
            android:textColor="@android:color/white"
            android:layout_gravity="center_vertical" />
    </LinearLayout>

    <!-- Profile -->
    <LinearLayout
        android:id="@+id/navProfile"
        android:layout_width="0dp"
        android:layout_height="@dimen/_38sdp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="@dimen/_7sdp"
        android:paddingEnd="@dimen/_7sdp">

        <ImageView
            android:id="@+id/iconProfile"
            android:layout_width="@dimen/_17sdp"
            android:layout_height="@dimen/_17sdp"
            android:src="@drawable/ic_nav_profile"
            android:contentDescription="Profile"
            android:layout_gravity="center_vertical" />

        <TextView
            android:id="@+id/labelProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_4sdp"
            android:text="Profile"
            android:textSize="@dimen/_10ssp"
            android:textStyle="bold"
            android:maxLines="1"
            android:visibility="invisible"
            android:textColor="@android:color/white"
            android:layout_gravity="center_vertical" />
    </LinearLayout>

</LinearLayout>