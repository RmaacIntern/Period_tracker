<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="24dp"
    android:paddingBottom="6dp">

    <!-- Date row -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvDayHeaderDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="YESTERDAY · SEP 17, 2026"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#2D1B33"
            android:letterSpacing="0.02"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvDayHeaderBadge"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvDayHeaderBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cycle Day 11"
            android:textSize="11sp"
            android:textColor="#A855F7"
            android:textStyle="bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Entry count -->
    <TextView
        android:id="@+id/tvDayEntryCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="2 logged moments"
        android:textSize="11sp"
        android:textColor="#8A7A8F" />

</LinearLayout>