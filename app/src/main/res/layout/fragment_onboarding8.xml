<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/onboarding8Root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".onboarding.OnboardingFragment8">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">

        <!-- Moon icon badge -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/moonBadge"
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:id="@+id/ivMoon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/menstrual_pain"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:ignore="ContentDescription" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Heading -->
        <TextView
            android:id="@+id/tvHeading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="And your natural rhythm"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#2D1B33"
            app:layout_constraintTop_toBottomOf="@id/moonBadge"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvSubheading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Not sure? Averages are 28 and 5. Period Tracker refines both with every period you log."
            android:textSize="13sp"
            android:textColor="#8A7A8F"
            app:layout_constraintTop_toBottomOf="@id/tvHeading"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Cycle length card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cycleLengthCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="18dp"
            app:layout_constraintTop_toBottomOf="@id/tvSubheading"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cycleIconBg"
                android:layout_width="32dp"
                android:layout_height="32dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <ImageView
                    android:id="@+id/ivCycleIcon"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/ic_cycle"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:ignore="ContentDescription" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/tvCycleLengthLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Cycle length"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#2D1B33"
                app:layout_constraintTop_toTopOf="@id/cycleIconBg"
                app:layout_constraintBottom_toBottomOf="@id/cycleIconBg"
                app:layout_constraintStart_toEndOf="@id/cycleIconBg"
                app:layout_constraintEnd_toStartOf="@id/tvCycleLengthValue" />

            <TextView
                android:id="@+id/tvCycleLengthValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="28 days"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#E63A5E"
                app:layout_constraintTop_toTopOf="@id/cycleIconBg"
                app:layout_constraintBottom_toBottomOf="@id/cycleIconBg"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.slider.Slider
                android:id="@+id/seekCycleLength"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:valueFrom="21"
                android:valueTo="45"
                android:stepSize="1"
                android:value="28"
                app:thumbColor="#E63A5E"
                app:trackColorActive="#E63A5E"
                app:trackColorInactive="#F6D9E4"
                app:labelBehavior="gone"
                app:layout_constraintTop_toBottomOf="@id/cycleIconBg"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvCycleMinLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="21 d"
                android:textSize="11sp"
                android:textColor="#8A7A8F"
                app:layout_constraintTop_toBottomOf="@id/seekCycleLength"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvCycleMaxLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="45 d"
                android:textSize="11sp"
                android:textColor="#8A7A8F"
                app:layout_constraintTop_toBottomOf="@id/seekCycleLength"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvCycleTypical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="Typically 21-35 days"
                android:textSize="11sp"
                android:textColor="#8A7A8F"
                app:layout_constraintTop_toBottomOf="@id/seekCycleLength"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvCycleMinLabel"
                app:layout_constraintEnd_toStartOf="@id/tvCycleMaxLabel" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Period length card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/periodLengthCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:padding="18dp"
            app:layout_constraintTop_toBottomOf="@id/cycleLengthCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/periodIconBg"
                android:layout_width="32dp"
                android:layout_height="32dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <ImageView
                    android:id="@+id/ivPeriodIcon"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/ic_period_drop"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:ignore="ContentDescription" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/tvPeriodLengthLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Period length"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#2D1B33"
                app:layout_constraintTop_toTopOf="@id/periodIconBg"
                app:layout_constraintBottom_toBottomOf="@id/periodIconBg"
                app:layout_constraintStart_toEndOf="@id/periodIconBg"
                app:layout_constraintEnd_toStartOf="@id/tvPeriodLengthValue" />

            <TextView
                android:id="@+id/tvPeriodLengthValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5 days"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#E63A5E"
                app:layout_constraintTop_toTopOf="@id/periodIconBg"
                app:layout_constraintBottom_toBottomOf="@id/periodIconBg"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.slider.Slider
                android:id="@+id/seekPeriodLength"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:valueFrom="2"
                android:valueTo="10"
                android:stepSize="1"
                android:value="5"
                app:thumbColor="#E63A5E"
                app:trackColorActive="#E63A5E"
                app:trackColorInactive="#F6D9E4"
                app:labelBehavior="gone"
                app:layout_constraintTop_toBottomOf="@id/periodIconBg"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvPeriodMinLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="2 d"
                android:textSize="11sp"
                android:textColor="#8A7A8F"
                app:layout_constraintTop_toBottomOf="@id/seekPeriodLength"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvPeriodMaxLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="10 d"
                android:textSize="11sp"
                android:textColor="#8A7A8F"
                app:layout_constraintTop_toBottomOf="@id/seekPeriodLength"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvPeriodTypical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="Typically 2-7 days"
                android:textSize="11sp"
                android:textColor="#8A7A8F"
                app:layout_constraintTop_toBottomOf="@id/seekPeriodLength"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvPeriodMinLabel"
                app:layout_constraintEnd_toStartOf="@id/tvPeriodMaxLabel" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Privacy note -->
        <ImageView
            android:id="@+id/ivLock"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="6dp"
            android:layout_marginTop="18dp"
            android:src="@drawable/ic_lock"
            app:layout_constraintTop_toBottomOf="@id/periodLengthCard"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvPrivacyText"
            app:layout_constraintHorizontal_chainStyle="packed"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/tvPrivacyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kept confidential and securely stored on-device"
            android:textSize="11sp"
            android:textColor="#8A7A8F"
            app:layout_constraintTop_toTopOf="@id/ivLock"
            app:layout_constraintBottom_toBottomOf="@id/ivLock"
            app:layout_constraintStart_toEndOf="@id/ivLock"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>