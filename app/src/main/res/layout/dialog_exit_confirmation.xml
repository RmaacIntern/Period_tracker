<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="@dimen/_20sdp"
    android:background="@drawable/bg_dialog_card">

    <!-- Icon circle -->
    <FrameLayout
        android:layout_width="@dimen/_48sdp"
        android:layout_height="@dimen/_48sdp">

        <View
            android:layout_width="@dimen/_48sdp"
            android:layout_height="@dimen/_48sdp"
            android:background="@drawable/bg_icon_soft_pink" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="i"
            android:textStyle="bold"
            android:textColor="#E63A5E"
            android:textSize="@dimen/_18ssp" />

    </FrameLayout>

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_14sdp"
        android:text="Leave Period Tracker?"
        android:textSize="@dimen/_15ssp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:gravity="center" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_7sdp"
        android:paddingHorizontal="@dimen/_14sdp"
        android:text="Your data is saved. Come back anytime to track your cycle."
        android:textSize="@dimen/_12ssp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3" />

    <!-- Stay in App button -->
    <Button
        android:id="@+id/btnStayInApp"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_44sdp"
        android:layout_marginTop="@dimen/_20sdp"
        android:text="Stay in App"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/_13ssp"
        android:backgroundTint="#EC4899"
        app:cornerRadius="@dimen/_12sdp" />

    <!-- Exit button -->
    <TextView
        android:id="@+id/btnExit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_7sdp"
        android:paddingTop="@dimen/_10sdp"
        android:paddingBottom="@dimen/_10sdp"
        android:paddingHorizontal="@dimen/_27sdp"
        android:text="Exit"
        android:textSize="@dimen/_12ssp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>