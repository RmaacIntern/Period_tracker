<?xml version="1.0" encoding="utf-8"?>
<com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nativeAdView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ad_card"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- TOP SECTION: AD LABEL + ICON + HEADLINE + META ROW -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- AD LABEL -->

            <TextView
                android:id="@+id/adLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_ad_badge"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="Ad"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- APP ICON (rounded) -->

            <ImageView
                android:id="@+id/adAppIcon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_icon_rounded"
                android:clipToOutline="true"
                android:contentDescription="Ad icon"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_gravity="center_vertical"
                android:orientation="vertical">

                <!-- HEADLINE -->

                <TextView
                    android:id="@+id/adHeadline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#202124"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- META ROW: STARS + PRICE + STORE -->

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <RatingBar
                        android:id="@+id/adStars"
                        style="?android:attr/ratingBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:isIndicator="true"
                        android:numStars="5"
                        android:stepSize="0.1" />

                    <TextView
                        android:id="@+id/adPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="FREE"
                        android:textColor="#5F6368"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/adStore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="#5F6368"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- BODY (2 lines) -->

        <TextView
            android:id="@+id/adBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#5F6368"
            android:textSize="13sp" />

        <!--
            NOTE: No MediaView here on purpose.

            Google's Next-Gen SDK docs: "If you prefer to render your
            native ad without a MediaView instance, pass the null
            value for the media view parameter when calling the
            registerNativeAd() method."

            A MediaView smaller than 120dp x 120dp triggers the
            "MediaView is too small for video" validator warning
            (and video creatives won't even serve to it), so rather
            than shrink one to 0dp, we simply don't declare one and
            pass null in NativeAdHelper.kt.
        -->

        <!-- ADVERTISER (kept for accessibility/policy, hidden by default) -->

        <TextView
            android:id="@+id/adAdvertiser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- CTA -->

        <!-- CTA -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/adCallToAction"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView>