<?xml version="1.0" encoding="utf-8"?>
<!-- One day group: header + all entry cards stacked inside -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/_17sdp">

    <!-- Day header row -->
    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/_7sdp">

        <TextView
            android:id="@+id/tvDayDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="TODAY · SEP 22"
            android:textSize="@dimen/_10ssp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:textColor="@color/text_primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvDayCycleDay"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvDayCycleDay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Day 14"
            android:textSize="@dimen/_9ssp"
            android:textColor="#A855F7"
            android:textStyle="bold"
            android:paddingHorizontal="@dimen/_7sdp"
            android:paddingVertical="@dimen/_2sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvEntryCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:text="2 entries"
            android:textSize="@dimen/_9ssp"
            android:textColor="@color/text_secondary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDayDate" />

        <!-- Edit button -->
        <TextView
            android:id="@+id/btnEditDay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:text="Edit"
            android:textSize="@dimen/_10ssp"
            android:textColor="#EC4899"
            android:textStyle="bold"
            android:padding="@dimen/_3sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDayCycleDay" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Card holding all entry rows -->
    <LinearLayout
        android:id="@+id/cardEntries"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_10sdp"
        android:paddingVertical="@dimen/_8sdp" />

</LinearLayout>