<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/_54sdp"
    android:paddingStart="@dimen/_10sdp"
    android:paddingEnd="@dimen/_10sdp"
    android:paddingTop="@dimen/_10sdp"
    android:paddingBottom="@dimen/_3sdp"
    android:clipToPadding="false"
    android:clipChildren="false">

    <!-- Delete button: anchored to parent top so its shadow/edge never gets clipped -->
    <ImageView
        android:id="@+id/btnDeleteEntry"
        android:layout_width="@dimen/_27sdp"
        android:layout_height="@dimen/_27sdp"
        android:layout_marginEnd="@dimen/_2sdp"
        android:padding="@dimen/_2sdp"
        android:src="@drawable/ic_delete"
        android:background="@drawable/bg_arrow_shadow"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:elevation="@dimen/_2sdp"
        android:scaleType="centerInside"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Delete entry"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Time: vertically centered on the delete button -->
    <TextView
        android:id="@+id/tvEntryTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="9:05 AM"
        android:textSize="@dimen/_12ssp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:maxLines="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnDeleteEntry"
        app:layout_constraintBottom_toBottomOf="@id/btnDeleteEntry" />

    <!-- Type label: baseline-aligned with time, ellipsizes on small screens -->
    <TextView
        android:id="@+id/tvEntryType"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_7sdp"
        android:layout_marginEnd="@dimen/_7sdp"
        android:text="Morning Log"
        android:textSize="@dimen/_10ssp"
        android:textColor="@color/text_secondary"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/tvEntryTime"
        app:layout_constraintEnd_toStartOf="@id/btnDeleteEntry"
        app:layout_constraintBaseline_toBaselineOf="@id/tvEntryTime" />

    <!-- Header bottom = whichever is taller (handles large font scaling) -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/headerBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="tvEntryTime,btnDeleteEntry" />

    <!-- Summary: flow · moods · symptoms -->
    <TextView
        android:id="@+id/tvEntrySummary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        android:text="Medium flow · Cramps · Fatigue"
        android:textSize="@dimen/_11ssp"
        android:textColor="@color/text_secondary"
        android:lineSpacingMultiplier="1.15"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerBarrier" />

    <!-- BBT row (hidden unless basalTemp logged) -->
    <LinearLayout
        android:id="@+id/bbtRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvEntrySummary">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_3sdp"
            android:text="🌡"
            android:textSize="@dimen/_10ssp" />

        <TextView
            android:id="@+id/tvBbt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="97.8°F"
            android:textSize="@dimen/_10ssp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

    </LinearLayout>

    <!-- Notes (hidden unless notes logged) -->
    <TextView
        android:id="@+id/tvNotes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        android:text=""
        android:textSize="@dimen/_10ssp"
        android:textColor="@color/text_secondary"
        android:textStyle="italic"
        android:lineSpacingMultiplier="1.15"
        android:visibility="gone"
        tools:text="Felt better after a walk"
        tools:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bbtRow" />

    <!-- Bottom spacer so last line never touches the divider/card edge -->
    <Space
        android:id="@+id/bottomSpace"
        android:layout_width="0dp"
        android:layout_height="@dimen/_7sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvNotes" />

    <!-- Divider between entries in same day (hidden on last entry) -->
    <View
        android:id="@+id/dividerEntry"
        android:layout_width="0dp"
        android:layout_height="@dimen/_1sdp"
        android:layout_marginTop="@dimen/_3sdp"
        android:background="@color/stroke_card"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bottomSpace" />

</androidx.constraintlayout.widget.ConstraintLayout>